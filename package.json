{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node scripts/verify-canonical-target.mjs && node scripts/build-pdf-viewer.mjs && node scripts/build-questionnaire-schema.mjs && node scripts/build-contract-renderer.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:anti-krizis": "ANTIKRIZIS_EXTERNAL_DEPLOY=1 npm run build",
    "deploy:anti-krizis": "npm run build:anti-krizis && wrangler deploy --config wrangler.anti-krizis.jsonc",
    "db:migrate:anti-krizis": "wrangler d1 migrations apply DB --remote --config wrangler.anti-krizis.jsonc",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
